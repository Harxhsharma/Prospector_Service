# =============================================================================
# CompanyParser — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
# All variables can also be set directly in your shell or Docker environment.

# --- Anthropic (required for LLM extraction) --------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- HuggingFace (optional, for /top LLM ranking) --------------------------
HF_TOKEN=your_huggingface_token_here

# --- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/
MONGO_DB=websites
MONGO_RECORDS_DB=Records

# --- Crawl tuning -----------------------------------------------------------
CRAWL_DELAY_SECONDS=23
